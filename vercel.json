{
  "functions": {
    "api/sync.ts": {
      "maxDuration": 300
    },
    "api/continue-sync.ts": {
      "maxDuration": 300
    },
    "api/health-monitor.ts": {
      "maxDuration": 60
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/health-monitor",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    }
  ]
}
