# Telegram Bot Konfiguration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Microsoft Graph API Konfiguration
# Erstelle eine App in Azure Portal: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here

# OneDrive Konfiguration
# Pfad zum zu überwachenden Ordner (z.B. "/Fotos" oder "/Documents/Bilder")
ONEDRIVE_FOLDER_PATH=/path/to/your/folder

# Rate Limiting (Millisekunden zwischen Posts)
RATE_LIMIT_DELAY=2000

# Storage Provider (wähle eine Option)
# Option 1: Upstash Redis (EMPFOHLEN - 10,000 commands/day free)
# Erstelle Account auf https://upstash.com und erstelle eine Redis Datenbank
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Option 2: Standard Redis (falls du eigenen Redis Server hast)
# REDIS_URL=redis://default:password@host:port

# Option 3: Vercel KV (nur wenn du bereits Vercel KV nutzt)
# KV_URL=your_kv_url
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token
# KV_REST_API_READ_ONLY_TOKEN=your_kv_rest_api_read_only_token
